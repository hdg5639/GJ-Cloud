# GamjaBox 루트 .env 템플릿
# 1) cp env.example .env
# 2) CHANGE_ME_* 값을 서버별 실제 값으로 교체
# 3) .env에서는 $(...)가 실행되지 않으므로 생성 명령의 출력을 붙여넣을 것
# 4) 개발·운영의 DB 비밀번호와 시크릿은 서로 다르게 생성하고 .env를 Git에 커밋하지 않을 것
# 일반 비밀번호/서비스 secret 생성: openssl rand -base64 48
# 정확히 UTF-8 32바이트가 필요한 Ops AES key 생성: openssl rand -base64 24

# ─── Compose 공통 ───
COMPOSE_PROJECT_NAME=gamjabox
DOCKER_NETWORK_NAME=loc-net
TZ=Asia/Seoul
SPRING_PROFILES_ACTIVE=prod
# 운영은 prod를 유지한다. 개발 문서 서버에서만 prod,docs로 변경한다.
# docs 프로파일이 비활성화된 운영에서는 아래 두 값이 Swagger를 열지 않는다.
DOCS_DOMAIN=docs.invalid
OPENAPI_SERVER_URL=http://localhost:9000
# 운영에서는 false 유지. 개발 API에 localhost/*.localhost Origin을 허용할 때만 true.
ENABLE_LOCAL_DEV_CORS=false
# Ops 터미널 WebSocket에 추가로 허용할 로컬 Origin. 쉼표로 구분하며 운영은 빈 값 유지.
LOCAL_DEV_ORIGINS=

# ─── Caddy / 랜딩 ───
# *_PATH는 compose.yaml이 있는 디렉토리 기준 호스트 경로
CADDY_IMAGE=caddy:2-alpine
CADDY_BIND_ADDRESS=0.0.0.0
CADDY_HTTP_PORT=80
CADDYFILE_PATH=./Caddyfile
LANDING_PATH=./gamjabox-landing
API_DOCS_UI_PATH=./api-docs-ui

# ─── Auth MySQL ───
MYSQL_IMAGE=mysql:8
MYSQL_AUTH_DATABASE=auth-db
MYSQL_USERNAME=root
MYSQL_ROOT_PASSWORD=CHANGE_ME_mysql_root_password
MYSQL_TIME_ZONE_OFFSET=+09:00
MYSQL_BIND_ADDRESS=127.0.0.1
MYSQL_HOST_PORT=3306

# ─── Redis ───
REDIS_IMAGE=redis:7-alpine
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_redis_password
REDIS_BIND_ADDRESS=127.0.0.1
REDIS_HOST_PORT=6379

# ─── Auth 서비스 ───
AUTH_IMAGE=gj-cloud-auth:latest
AUTH_BIND_ADDRESS=127.0.0.1
AUTH_HOST_PORT=8080
AUTH_DB_URL=jdbc:mysql://mysql:3306/auth-db?createDatabaseIfNotExist=true
AUTH_SERVER_URL=http://auth:8080

# ─── User 서비스 / 파일 저장소 ───
# *_HOST_PATH는 영속 데이터를 둘 호스트 절대경로, *_STORAGE_PATH는 컨테이너 내부 경로
USER_IMAGE=gj-cloud-user:latest
USER_BIND_ADDRESS=127.0.0.1
USER_HOST_PORT=8081
USER_DB_URL=jdbc:mysql://mysql:3306/user-db?createDatabaseIfNotExist=true
USER_SERVICE_URL=http://user:8080
PROFILE_IMAGE_HOST_PATH=/opt/gamjabox/data/profile-images
PROFILE_IMAGE_STORAGE_PATH=/data/profile-images
PROFILE_IMAGE_PUBLIC_URL_PREFIX=/users/uploads/profile-images
DOCS_IMAGE_HOST_PATH=/opt/gamjabox/data/docs-images
DOCS_IMAGE_STORAGE_PATH=/data/docs-images
DOCS_IMAGE_PUBLIC_URL_PREFIX=/users/docs/images

# ─── VM PostgreSQL / VM 서비스 ───
POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_VM_DATABASE=vm_db
POSTGRES_VM_USERNAME=postgres
POSTGRES_VM_PASSWORD=CHANGE_ME_vm_postgres_password
POSTGRES_VM_BIND_ADDRESS=127.0.0.1
POSTGRES_VM_HOST_PORT=5432

VM_IMAGE=gj-cloud-vm:latest
VM_BIND_ADDRESS=127.0.0.1
VM_HOST_PORT=8082
VM_DB_URL=r2dbc:postgresql://postgres-vm:5432/vm_db
VM_SERVICE_URL=http://vm:8080

# ─── Ops PostgreSQL / Ops 서비스 ───
POSTGRES_OPS_DATABASE=ops_db
POSTGRES_OPS_USERNAME=postgres
POSTGRES_OPS_PASSWORD=CHANGE_ME_ops_postgres_password
POSTGRES_OPS_BIND_ADDRESS=127.0.0.1
POSTGRES_OPS_HOST_PORT=5433

OPS_IMAGE=gj-cloud-ops:latest
OPS_BIND_ADDRESS=127.0.0.1
OPS_HOST_PORT=8083
OPS_DB_URL=jdbc:postgresql://postgres-ops:5432/ops_db
OPS_SERVICE_URL=http://ops:8080

# ─── Auth RS256 JWT ───
# JWT_PRIVATE_KEY: PKCS#8 DER의 Base64 한 줄, JWT_PUBLIC_KEY: X.509 DER의 Base64 한 줄
# 생성 예시:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:3072 -out jwt-private.pem
#   openssl pkcs8 -topk8 -nocrypt -in jwt-private.pem -outform DER | base64 | tr -d '\n'
#   openssl pkey -in jwt-private.pem -pubout -outform DER | base64 | tr -d '\n'
JWT_PRIVATE_KEY=CHANGE_ME_base64_pkcs8_der_private_key
JWT_PUBLIC_KEY=CHANGE_ME_base64_x509_der_public_key
JWT_REMEMBER_ME_REFRESH_TOKEN_EXPIRY=2592000000

# ─── 메일(SMTP) ───
# Gmail은 일반 계정 비밀번호가 아니라 2단계 인증으로 발급한 앱 비밀번호를 사용
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=noreply@gamjabox.cloud
MAIL_PASSWORD=CHANGE_ME_smtp_app_password
MAIL_FROM="GamjaBox <noreply@gamjabox.cloud>"
EMAIL_VERIFICATION_ENABLED=true

# ─── 서비스 간 client-credentials ───
# 각 값은 openssl rand -base64 48로 별도 생성
USER_SERVICE_CLIENT_SECRET=CHANGE_ME_user_service_client_secret
VM_SERVICE_CLIENT_SECRET=CHANGE_ME_vm_service_client_secret
OPS_SERVICE_CLIENT_SECRET=CHANGE_ME_ops_service_client_secret

# ─── Proxmox ───
# URL은 API root까지 포함. Token ID 형식: <user>@<realm>!<token-name>
PROXMOX_URL=https://pve.example.internal:8006/api2/json
PROXMOX_TOKEN_ID=gamjabox@pve!api
PROXMOX_TOKEN_SECRET=CHANGE_ME_proxmox_api_token_secret
PROXMOX_NODE=pve
PROXMOX_BRIDGE=vmbr0
PROXMOX_STORAGE=local-lvm
PROXMOX_VMID_START=1000
PROXMOX_VMID_END=8999
SYSTEM_WORKER_AUTO_PREVIEW_ENABLED=true
SYSTEM_WORKER_AUTO_PREVIEW_VMID=300
SYSTEM_WORKER_AUTO_PREVIEW_CORES=4
SYSTEM_WORKER_AUTO_PREVIEW_MEMORY_MB=5120
SYSTEM_WORKER_AUTO_PREVIEW_DISK_GB=80
SYSTEM_WORKER_AUTO_PREVIEW_TEMPLATE_VMID=9026
SYSTEM_WORKER_AUTO_PREVIEW_NAME=gamjabox-auto-preview-worker
SYSTEM_WORKER_AUTO_PREVIEW_POOL=system-worker
MANAGED_PREVIEW_PORT_START=20000
MANAGED_PREVIEW_PORT_END=20999
MANAGED_PREVIEW_FREE_TTL_HOURS=6
MANAGED_PREVIEW_PRO_TTL_HOURS=24

# ─── Cloudflare ───
# Dashboard에서 Account ID, Zone ID, Tunnel UUID를 확인. API Token은 DNS/Tunnel/Access 최소 권한으로 발급
CLOUDFLARE_API_TOKEN=CHANGE_ME_cloudflare_api_token
CLOUDFLARE_ACCOUNT_ID=CHANGE_ME_cloudflare_account_id
CLOUDFLARE_ZONE_ID=CHANGE_ME_cloudflare_zone_id
CLOUDFLARE_TUNNEL_ID=CHANGE_ME_cloudflare_tunnel_uuid
CLOUDFLARE_BASE_DOMAIN=gamjabox.cloud
# 개발·내부용 실제 CNAME label은 서버 .env에만 기록하고 공개 템플릿에는 남기지 않는다.
RESERVED_SUBDOMAINS=www,portal,admin,api,ssh,docs,CHANGE_ME_internal_docs_subdomain

# ─── Ops 암호화 / Git sandbox / 백업 ───
# 두 AES key는 openssl rand -base64 24의 서로 다른 출력(정확히 32자)을 사용하고, 백업 생성 후 변경 금지
OPS_KEY_ENCRYPTION_SECRET=CHANGE_ME_exactly_32_byte_ops_key
OPS_BACKUP_ENCRYPTION_SECRET=CHANGE_ME_exactly_32_byte_backup_key
OPS_GIT_ALLOWED_HOSTS=github.com,gitlab.com,bitbucket.org
OPS_GIT_EGRESS_PROXY_IMAGE=gj-cloud-ops-git-egress-proxy:latest
OPS_GIT_LOCAL_EGRESS_PROXY_URL=http://ops-git-egress-proxy:3128
# 선택: 사용자 VM에서 도달 가능한 LAN proxy가 있을 때만 주석을 풀고 설정
# OPS_GIT_REMOTE_EGRESS_PROXY_URL=http://192.168.0.10:3128
OPS_REPO_ANALYSIS_MAX_CLONE_SIZE_BYTES=268435456
OPS_REPO_ANALYSIS_MAX_MEMORY_BYTES=536870912
OPS_REPO_ANALYSIS_MAX_CPU_SECONDS=60
OPS_REPO_ANALYSIS_MAX_PROCESSES=64
OPS_TMPFS_SIZE=512m
OPS_CONTAINER_PIDS_LIMIT=256
OPS_CONTAINER_MEMORY_LIMIT=1g
OPS_CONTAINER_CPU_LIMIT=2.0
OPS_BACKUP_RETENTION_DAYS=30
OPS_BACKUP_MAX_FILES_PER_VM=20
OPS_DEPLOYMENT_ORPHAN_RECONCILE_INTERVAL_MS=300000
VM_SSH_USERNAME=ubuntu
PORTAL_ORIGIN=https://portal.gamjabox.cloud
ADMIN_ORIGIN=https://admin.example.test
OPENAI_API_KEY=CHANGE_ME_openai_api_key
AI_MODEL_STANDARD=gpt-5.6-terra
AI_MODEL_ESCALATED=gpt-5.6-sol
OPS_FILE_BROWSER_MAX_EDIT_SIZE_BYTES=26214400
OPS_FILE_BROWSER_MAX_UPLOAD_SIZE_BYTES=26214400

# ─── GitHub App ───
# App ID(숫자)와 OAuth Client ID(Iv1...)는 다른 값. Private key는 GitHub App에서 발급한 PEM을 \n 문자로 연결
GITHUB_APP_ID=CHANGE_ME_github_app_numeric_id
GITHUB_APP_SLUG=CHANGE_ME_github_app_slug
GITHUB_APP_CLIENT_ID=Iv1.CHANGE_ME
GITHUB_APP_CLIENT_SECRET=CHANGE_ME_github_oauth_client_secret
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nCHANGE_ME_github_app_private_key_body\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=CHANGE_ME_github_webhook_secret

# ─── Portal ───
# NEXT_PUBLIC_* 값은 브라우저 번들에 포함되므로 secret을 넣지 말 것. 현재 Caddy 구성은 모든 API를 portal 도메인으로 라우팅
PORTAL_IMAGE=gj-cloud-portal:latest
PORTAL_BIND_ADDRESS=127.0.0.1
PORTAL_HOST_PORT=3000
NEXT_PUBLIC_AUTH_API=https://portal.gamjabox.cloud
NEXT_PUBLIC_USER_API=https://portal.gamjabox.cloud
NEXT_PUBLIC_VM_API=https://portal.gamjabox.cloud
NEXT_PUBLIC_OPS_API=https://portal.gamjabox.cloud
NEXT_PUBLIC_ADMIN_API=https://admin.example.test
ADMIN_DOMAIN=admin.example.test

# ─── 선택: 외부 Elasticsearch Blueprint 검색 ───
# 기본은 Registry fallback이므로 필요할 때만 BLUEPRINT_SEARCH_ENABLED=true로 변경
BLUEPRINT_SEARCH_ENABLED=false
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_USERNAME=CHANGE_ME_if_authentication_is_enabled
ELASTICSEARCH_PASSWORD=CHANGE_ME_if_authentication_is_enabled
BLUEPRINT_SEARCH_INDEX=gamjabox-blueprints-v1
BLUEPRINT_SEARCH_REINDEX_ON_STARTUP=false
