COMPOSE_PROJECT_NAME=gamjabox
DOCKER_NETWORK_NAME=loc-net
TZ=Asia/Seoul
SPRING_PROFILES_ACTIVE=prod

CADDY_IMAGE=caddy:2-alpine
CADDY_BIND_ADDRESS=0.0.0.0
CADDY_HTTP_PORT=80
CADDYFILE_PATH=./Caddyfile
LANDING_PATH=./gamjabox-landing

MYSQL_IMAGE=mysql:8
MYSQL_AUTH_DATABASE=auth-db
MYSQL_USERNAME=root
MYSQL_ROOT_PASSWORD=
MYSQL_TIME_ZONE_OFFSET=+09:00
MYSQL_BIND_ADDRESS=127.0.0.1
MYSQL_HOST_PORT=3306

REDIS_IMAGE=redis:7-alpine
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_BIND_ADDRESS=127.0.0.1
REDIS_HOST_PORT=6379

AUTH_IMAGE=gj-cloud-auth:latest
AUTH_BIND_ADDRESS=127.0.0.1
AUTH_HOST_PORT=8080
AUTH_DB_URL=jdbc:mysql://mysql:3306/auth-db?createDatabaseIfNotExist=true
AUTH_SERVER_URL=http://auth:8080

USER_IMAGE=gj-cloud-user:latest
USER_BIND_ADDRESS=127.0.0.1
USER_HOST_PORT=8081
USER_DB_URL=jdbc:mysql://mysql:3306/user-db?createDatabaseIfNotExist=true
USER_SERVICE_URL=http://user:8080
PROFILE_IMAGE_HOST_PATH=/opt/gamjabox/data/profile-images
PROFILE_IMAGE_STORAGE_PATH=/data/profile-images
PROFILE_IMAGE_PUBLIC_URL_PREFIX=
DOCS_IMAGE_HOST_PATH=/opt/gamjabox/data/docs-images
DOCS_IMAGE_STORAGE_PATH=/data/docs-images
DOCS_IMAGE_PUBLIC_URL_PREFIX=/users/docs/images

POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_VM_DATABASE=vm_db
POSTGRES_VM_USERNAME=postgres
POSTGRES_VM_PASSWORD=
POSTGRES_VM_BIND_ADDRESS=127.0.0.1
POSTGRES_VM_HOST_PORT=5432

VM_IMAGE=gj-cloud-vm:latest
VM_BIND_ADDRESS=127.0.0.1
VM_HOST_PORT=8082
VM_DB_URL=r2dbc:postgresql://postgres-vm:5432/vm_db
VM_SERVICE_URL=http://vm:8080

POSTGRES_OPS_DATABASE=ops_db
POSTGRES_OPS_USERNAME=postgres
POSTGRES_OPS_PASSWORD=
POSTGRES_OPS_BIND_ADDRESS=127.0.0.1
POSTGRES_OPS_HOST_PORT=5433

OPS_IMAGE=gj-cloud-ops:latest
OPS_BIND_ADDRESS=127.0.0.1
OPS_HOST_PORT=8083
OPS_DB_URL=jdbc:postgresql://postgres-ops:5432/ops_db
OPS_SERVICE_URL=http://ops:8080

JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_REMEMBER_ME_REFRESH_TOKEN_EXPIRY=2592000000

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
EMAIL_VERIFICATION_ENABLED=true

USER_SERVICE_CLIENT_SECRET=
VM_SERVICE_CLIENT_SECRET=
OPS_SERVICE_CLIENT_SECRET=

PROXMOX_URL=
PROXMOX_TOKEN_ID=
PROXMOX_TOKEN_SECRET=
PROXMOX_NODE=pve
PROXMOX_BRIDGE=vmbr0
PROXMOX_STORAGE=local-lvm
PROXMOX_VMID_START=1000
PROXMOX_VMID_END=8999

CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_TUNNEL_ID=
CLOUDFLARE_BASE_DOMAIN=gamjabox.cloud
RESERVED_SUBDOMAINS=

OPS_KEY_ENCRYPTION_SECRET=
VM_SSH_USERNAME=ubuntu
PORTAL_ORIGIN=
OPENAI_API_KEY=
AI_MODEL_STANDARD=
AI_MODEL_ESCALATED=
OPS_FILE_BROWSER_MAX_EDIT_SIZE_BYTES=26214400
OPS_FILE_BROWSER_MAX_UPLOAD_SIZE_BYTES=26214400

GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

PORTAL_IMAGE=gj-cloud-portal:latest
PORTAL_BIND_ADDRESS=127.0.0.1
PORTAL_HOST_PORT=3000
NEXT_PUBLIC_AUTH_API=
NEXT_PUBLIC_USER_API=
NEXT_PUBLIC_VM_API=
NEXT_PUBLIC_OPS_API=
NEXT_PUBLIC_ADMIN_API=
ADMIN_DOMAIN=
